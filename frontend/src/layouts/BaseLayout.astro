---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "SPH System - Gestión inteligente de horarios escolares",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>
  <body class="font-sans">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  /* ── Tailwind v4: animaciones personalizadas vía @theme ── */
  @theme {
    --animate-float-y: floatY 4s ease-in-out infinite;
    --animate-float-y-d: floatY 6s ease-in-out 1s infinite;
    --animate-blob-1: blobFloat1 7s ease-in-out infinite;
    --animate-blob-1-rev: blobFloat1 6s ease-in-out infinite reverse;
    --animate-blob-2: blobFloat2 9s ease-in-out infinite;
    --animate-blob-3: blobFloat3 8s ease-in-out infinite;
    --animate-spin-slow: slowSpin 30s linear infinite;
    --animate-spin-slow-rev: slowSpinRev 20s linear infinite;
  }

  /* ── Keyframes globales ── */
  @keyframes floatY {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }
  @keyframes blobFloat1 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(10px, -15px) scale(1.05);
    }
    66% {
      transform: translate(-8px, 8px) scale(0.95);
    }
  }
  @keyframes blobFloat2 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    50% {
      transform: translate(-12px, 18px) rotate(10deg);
    }
  }
  @keyframes blobFloat3 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    40% {
      transform: translate(14px, -10px) scale(1.08);
    }
    80% {
      transform: translate(-6px, 12px) scale(0.94);
    }
  }
  @keyframes slowSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes slowSpinRev {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  /* ── Lo único que Tailwind NO puede hacer: pseudo-elementos de select ── */
  .auth-select option {
    background-color: #1a3a6e;
    color: #fff;
  }
</style>
